{
  "info": {
    "title": "AI智能助手",
    "description": "",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "components": {
    "schemas": {
      "VideoTaskData": {
        "type": "object",
        "required": ["id", "status", "amount"],
        "properties": {
          "id": {
            "type": "integer",
            "description": "任务的 ID 记录。",
            "example": 11
          },
          "status": {
            "type": "string",
            "enum": ["Running", "Success", "Failed"],
            "description": "任务状态。",
            "example": "Running"
          },
          "amount": {
            "type": "number",
            "description": "任务所消耗的算力。",
            "example": 100
          }
        }
      },
      "VideoTaskResponse": {
        "type": "object",
        "required": ["status", "message", "data"],
        "properties": {
          "status": {
            "type": "integer",
            "description": "状态码，100 表示成功，其他表示失败。",
            "example": 100
          },
          "message": {
            "type": "string",
            "description": "操作结果的提示消息。",
            "example": "操作成功"
          },
          "data": {
            "$ref": "#/components/schemas/VideoTaskData"
          }
        }
      },
      "VideoResultData": {
        "type": "object",
        "required": ["id", "status", "response_json"],
        "properties": {
          "id": {
            "type": "integer",
            "description": "任务的 ID 记录。",
            "example": 20
          },
          "status": {
            "type": "string",
            "enum": ["Running", "Success", "Failed"],
            "description": "任务的状态。\nRunning 表示正在运行，\nSuccess 表示成功，\nFailed 表示失败。",
            "example": "Success"
          },
          "response_json": {
            "type": "object",
            "description": "执行结果内容。",
            "example": "# AD钙奶产品市场调研报告\n\n## 一、品牌背..."
          }
        }
      },
      "VideoResultResponse": {
        "type": "object",
        "required": ["status", "message", "data"],
        "properties": {
          "status": {
            "type": "integer",
            "description": "响应状态码。",
            "example": 100
          },
          "message": {
            "type": "string",
            "description": "响应消息。",
            "example": "操作成功"
          },
          "data": {
            "$ref": "#/components/schemas/VideoResultData"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "在 Authorization 请求头中传入带 Bearer 头的 API 密钥，例如：Bearer xxxxxx \n[如何获取 API 密钥？](/dev/open/get-bearer-token)"
      }
    }
  },
  "tags": [
    {
      "name": "视频生成",
