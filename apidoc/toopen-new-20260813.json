      "description": "Seedance2.0 体验3相关接口"
    }
  ],
  "paths": {
    "/upload": {
      "post": {
        "summary": "上传文件",
        "description": "支持上传：图片、视频与音频，只保存3小时。",
        "x-mint": {
          "href": "/openapi-ref/upload",
          "content": "<Warning>上传后，文件只会保留 3 小时。</Warning>",
          "metadata": {
            "sidebarTitle": "上传文件"
          }
        },
        "tags": ["临时储存"],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "description": "文件",
                    "format": "binary"
                  }
                },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "message", "data"],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 100
                    },
                    "message": {
                      "type": "string",
                      "example": "操作成功"
                    },
                    "data": {
                      "type": "object",
                      "required": ["full_url"],
                      "properties": {
                        "full_url": {
                          "type": "string",
                          "format": "uri",
                          "example": ".../1785314758_65f4ec.mp4"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "status": 100,
                  "message": "操作成功",
                  "data": {
                    "full_url": ".../1785314758_65f4ec.mp4"
                  }
                }
              }
            }
          },
          "404": {
            "description": "失败",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                }
              }
            }
          }
        },
        "operationId": "uploadTemporaryFile"
      }
    },
    "/workflow/getResult": {
      "post": {
        "x-mint": {
          "href": "/openapi-ref/workflow/get-result",
          "metadata": {
            "sidebarTitle": "获取生成结果"
          }
        },
        "summary": "获取生成结果",
        "description": "",
        "tags": ["视频生成-获取生成结果"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "number",
                    "description": "会话ID",
                    "example": 1
                  }
                },
                "required": ["id"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoResultResponse"
                },
                "example": {
                  "status": 100,
                  "message": "操作成功",
                  "data": {
                    "id": 20,
                    "status": "Success",
                    "response_json": "Example content."
                  }
                }
              }
            }
          },
          "404": {
            "description": "失败",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                }
              }
            }
          }
        },
        "operationId": "getVideoResult"
      }
    },
    "/workflow/seedanceDiscountChannel1": {
      "post": {
        "x-mint": {
          "href": "/openapi-ref/workflow/seedance-discount-channel1",
          "metadata": {
            "sidebarTitle": "Seedance2.0 体验1"
          }
        },
        "summary": "Seedance2.0 体验1",
        "description": "",
        "tags": ["视频生成-Seedance2.0 体验1"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "prompt": {
                    "type": "string",
                    "description": "提示词",
                    "example": "生成一段科幻世界的视频",
                    "default": ""
                  },
                  "aspect_ratio": {
                    "type": "integer",
                    "description": "画面比例\n1:【16:9】\n2:【9:16】\n3:【1:1】\n【注意：当模型选择了《满血-不支持人脸-9图0视频0音频》 ，画面比例只能使用16:9和9:16】",
                    "example": 2,
                    "enum": [1, 2, 3]
                  },
                  "model_option": {
                    "type": "integer",
                    "description": "模型\n4：满血-不支持人脸-9 图 0 视频 0 音频",
                    "example": 4,
                    "enum": [4]
                  },
                  "resolution_option": {
                    "type": "integer",
                    "description": "分辨率\n1：代表 480p\n2：代表 720p\n3：代表 1080p\n4：代表 4k\n【注意：当模型选择《满血-不支持人脸-9 图 0 视频 0 音频》只支持 720p】",
                    "example": 2,
                    "enum": [2]
                  },
                  "reference_urls": {
                    "type": "array",
                    "description": "参考素材\n1. 当选择《满血-不支持人脸-9图0视频0音频》，支持 9 参考图、3 参考视频、3 参考音频",
                    "items": {
                      "type": "string",
                      "format": "uri"
                    },
                    "example": [
                      "https://ark-project.tos-cn-beijing.volces.com/doc_image/r2v_tea_pic1.jpg",
                      "https://ark-project.tos-cn-beijing.volces.com/doc_image/r2v_tea_pic2.jpg"
                    ]
                  },
                  "duration": {
                    "type": "integer",
                    "description": "生成视频时长（秒）",
                    "example": 15
                  }
                },
                "required": [
                  "prompt",
                  "aspect_ratio",
                  "model_option",
                  "resolution_option",
                  "duration"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoTaskResponse"
                },
                "example": {
                  "status": 100,
                  "message": "操作成功",
                  "data": {
                    "id": 11,
                    "status": "Running",
                    "amount": 100
                  }
                }
              }
            }
          }
        },
        "operationId": "createSeedanceExperience1Video"
      }
    },
    "/workflow/seedanceDiscountChannel2": {
      "post": {
        "x-mint": {
          "href": "/openapi-ref/workflow/seedance-discount-channel2",
          "metadata": {
            "sidebarTitle": "Seedance2.0 体验2"
          }
        },
        "summary": "Seedance2.0 体验2",
        "description": "",
        "tags": ["视频生成-Seedance2.0 体验2"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "prompt": {
                    "type": "string",
                    "description": "提示词",
                    "example": "全程使用视频1的第一视角构图，全程使用音频1作为背景音乐。第一人称视角果茶宣传广告，seedance牌「苹苹安安」苹果果茶限定款；首帧为图片1，你的手摘下一颗带晨露的阿克苏红苹果，轻脆的苹果碰撞声；2-4 秒：第一人称手持举杯，你将图片2中的果茶举到镜头前（模拟递到观众面前的视角），杯身标签清晰可见，背景音「来一口鲜爽」，尾帧定格为图片2。背景声音统一为女生音色。",
                    "default": ""
                  },
                  "aspect_ratio": {
                    "type": "integer",
                    "description": "画面比例\n1:【16:9】\n2:【9:16】\n3:【1:1】\n4:【3:4】",
                    "example": 2,
                    "enum": [1, 2, 3, 4]
                  },
                  "model_option": {
                    "type": "integer",
                    "description": "模型选择\n1：满血-支持人脸-9 图 3 视频 3 音频\n2: 稳定-满血-支持人脸-9 图 3 视频 3 音频",
                    "example": 1,
                    "enum": [1, 2]
                  },
                  "resolution_option": {
                    "type": "integer",
                    "description": "分辨率\n2：代表720p",
                    "example": 2,
                    "enum": [2]
                  },
                  "reference_urls": {
                    "type": "array",
                    "description": "参考素材\n1. 模型《满血-支持人脸-9图3视频3音频》：支持 9 参考图、3 参考视频、3 参考音频。\n2. 模型《稳定-满血-支持人脸-9图3视频3音频》：支持 9 参考图、3 参考视频、3 参考音频。",
                    "items": {
                      "type": "string",
                      "format": "uri"
                    },
                    "example": [
                      "https://ark-project.tos-cn-beijing.volces.com/doc_image/r2v_tea_pic1.jpg",
                      "https://ark-project.tos-cn-beijing.volces.com/doc_image/r2v_tea_pic2.jpg",
                      "https://ark-project.tos-cn-beijing.volces.com/doc_audio/r2v_tea_audio1.mp3",
                      "https://ark-project.tos-cn-beijing.volces.com/doc_video/r2v_tea_video1.mp4"
                    ]
                  },
                  "duration": {
                    "type": "integer",
                    "description": "生成视频时长（4–15 秒）",
                    "minimum": 4,
                    "maximum": 15,
                    "example": 15
                  }
                },
                "required": [
                  "prompt",
                  "aspect_ratio",
                  "model_option",
                  "resolution_option",
                  "duration"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoTaskResponse"
                },
                "example": {
                  "status": 100,
                  "message": "操作成功",
                  "data": {
                    "id": 11,
                    "status": "Running",
                    "amount": 100
                  }
                }
              }
            }
          }
        },
        "operationId": "createSeedanceExperience2Video"
      }
    },
