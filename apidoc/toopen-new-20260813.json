    "/workflow/seedanceDiscount": {
      "post": {
        "x-mint": {
          "href": "/openapi-ref/workflow/seedance-discount",
          "metadata": {
            "sidebarTitle": "Seedance2.0 限时折扣（支持人脸）"
          }
        },
        "summary": "Seedance2.0 限时折扣（支持人脸）",
        "description": "",
        "tags": ["视频生成-Seedance2.0 限时折扣（支持人脸）"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "prompt": {
                    "type": "string",
                    "description": "文本提示词",
                    "example": "景别：中景\n画面内容：小青背对镜头站在展馆前，随后转身回头，脱掉衣服，朝镜头招手打招呼；接着再朝镜头外挥手。\n表演/动作：先回头微笑，再自然挥手。\n镜头建议：镜头稳定，中景构图保留建筑背景。",
                    "default": "景别：中景\n画面内容：小青背对镜头站在展馆前，随后转身回头，脱掉衣服，朝镜头招手打招呼；接着再朝镜头外挥手。\n表演/动作：先回头微笑，再自然挥手。\n镜头建议：镜头稳定，中景构图保留建筑背景。"
                  },
                  "resolution_option": {
                    "type": "integer",
                    "description": "分辨率\n1：代表 480P\n2：代表 720P\n3：代表 1080P",
                    "example": 1,
                    "enum": [1, 2, 3]
                  },
                  "duration": {
                    "type": "integer",
                    "description": "时长",
                    "example": 5
                  },
                  "aspect_ratio": {
                    "type": "integer",
                    "description": "画面比例\n1：代表【16:9】\n2：代表【9:16】\n3：代表【1:1】\n4：代表【4:3】\n5：代表【3:4】",
                    "example": 3,
                    "enum": [1, 2, 3, 4, 5]
                  },
                  "reference_urls": {
                    "type": "array",
                    "description": "参考图/视频/音频\n\n支持9参考图、3参考视频、3参考音频。\n\n视频：仅支持mp4、mov格式，分辨率480P、720P，时长2-15s，单视频不超过50MB;\n图片：单图小于30MB(总大小不超过64MB)\n音频：仅支持wav、mp3格式，时长2-15s，单个音频不超过15MB;",
                    "items": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "description": "素材库资源 ID，字符类型必须是整形。"
                        },
                        {
                          "type": "string",
                          "format": "uri",
                          "description": "资源 URL"
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "prompt",
                  "resolution_option",
                  "duration",
                  "aspect_ratio"
                ]
              }
            }
          }
