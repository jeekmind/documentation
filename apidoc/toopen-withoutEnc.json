        "type": "object",
        "required": [
          "status",
          "message",
          "data"
        ],
        "properties": {
          "status": {
            "type": "integer",
            "description": "业务状态码",
            "example": 100
          },
          "message": {
            "type": "string",
            "description": "提示信息",
            "example": "操作成功"
          },
          "data": {
            "type": "object",
            "required": [
              "id",
              "status",
              "amount"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "description": "任务 ID",
                "example": 11
              },
              "status": {
                "type": "string",
                "description": "任务状态",
                "example": "Running"
              },
              "amount": {
                "type": "number",
                "description": "消耗金额或算力",
                "example": 100
              }
            }
          }
        }
      },
      "TaskResultResponse": {
        "type": "object",
        "required": [
          "status",
          "message",
          "data"
        ],
        "properties": {
          "status": {
            "type": "integer",
            "description": "业务状态码",
            "example": 100
          },
          "message": {
            "type": "string",
            "description": "提示信息",
            "example": "操作成功"
          },
          "data": {
            "type": "object",
            "required": [
              "id",
              "status",
              "response_json"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "description": "任务 ID",
                "example": 20
              },
              "status": {
                "type": "string",
                "description": "任务状态",
                "example": "Success"
              },
              "response_json": {
                "description": "任务生成结果，可为 JSON 数据或字符串"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "description": "业务状态码"
          },
          "message": {
            "type": "string",
            "description": "错误信息"
          },
          "data": {
            "description": "错误详情"
          }
        }
      }
    }
  },
